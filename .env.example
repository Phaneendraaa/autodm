DATABASE_URL=postgres://...            # Neon/Supabase connection string
JWT_SECRET=long-random-string
ENC_KEY=another-long-random-string
IG_APP_ID=                             # Meta app > Instagram > Instagram app ID
IG_APP_SECRET=                         # Instagram app secret
VERIFY_TOKEN=any-random-string         # same value goes in Meta webhook config
APP_URL=https://your-app.vercel.app
ADMIN_EMAIL=you@example.com            # signing up with this email makes you admin
SETUP_KEY=random-string                # used once at /api/setup?key=...
